# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL Runtime Credentials (automatically injected in AI Studio Cloud SQL runtime)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Payment Gateway Sandbox / Webhook Verification (Razorpay)
RAZORPAY_KEY_ID="rzp_test_embertable_demo"
RAZORPAY_KEY_SECRET="embertable_sandbox_hmac_secret"
RAZORPAY_WEBHOOK_SECRET="embertable_webhook_hmac_secret"
